{
  "name": "tavern-trpg-assistant",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "gen:brew-validator": "node tools/vendor-brew-schema.mjs && node tools/build-brew-validator.mjs && node tools/build-brew-fields.mjs",
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "npm run build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "json-source-map": "^0.6.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "8.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "fast-uri": "3.1.0",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.32.6",
    "smartcrop-sharp": "^2.0.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
