{
  "name": "tavern-trpg-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "npm run build:data && npm run build && node tests/e2e/smoke.mjs",
    "build:data": "tsx tools/data/build.ts",
    "publish:data": "tsx tools/data/publish.ts",
    "test:data": "vitest run --config vitest.data.config.ts",
    "shots": "node tests/e2e/screenshots.mjs",
    "keys": "node tests/e2e/keyboard.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
