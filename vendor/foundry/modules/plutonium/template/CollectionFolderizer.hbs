<div class="ve-flex-col ve-window ve-min-h-0 ve-h-100">
	<div class="ve-flex-v-center ve-mb-2">
		<div class="ve-mr-2">Select Target Directory</div>
		<select name="sel-folder" class="ve-form-control ve-w-initial">
			<option value="" disabled selected>Select</option>
			{{#each folders}}
				<option value="{{id}}">{{name}}</option>
			{{/each}}
		</select>
	</div>

	<div class="ve-flex-v-stretch ve-input-group ve-input-group--top">
		<button class="ve-btn ve-btn-5et veapp__btn-filter" name="btn-filter">Filter</button>
		<button class="ve-btn ve-btn-5et" title="Toggle Filter Summary Display" name="btn-toggle-summary"><span class="glyphicon glyphicon-resize-small"></span></button>
		<input type="search" class="search ve-w-100 ve-form-control ve-h-initial" placeholder="Find {{titleSearch}}...">
		<button class="ve-btn ve-btn-5et veapp__btn-list-reset" name="btn-reset">Reset</button>
	</div>

	<div class="ve-fltr__mini-view ve-btn-group"></div>

	<div class="ve-flex-v-stretch ve-input-group ve-input-group--bottom ve-mb-1" data-name="wrp-btns-sort">
		<label class="ve-btn ve-btn-5et ve-col-2 ve-flex-vh-center"><input type="checkbox" name="cb-select-all"></label>
		<button class="ve-btn ve-btn-5et ve-col-10 sort name" data-sort="name">Name</button>
	</div>

	<div class="veapp__list ve-h-100 ve-mb-1">
		{{#each rows}}
			<label class="ve-flex ve-w-100 veapp__list-row veapp__list-row-hoverable">
				<span class="ve-col-2 ve-flex-vh-center"><input type="checkbox" class="ve-no-events"></span>
				<span class="ve-col-10 name">{{displayName}}</span>
			</label>
		{{/each}}
	</div>

	<div class="ve-flex-v-end">
		<button class="ve-btn ve-btn-5et ve-mr-2 ve-w-100" name="btn-run">Move</button>
	</div>
</div>
