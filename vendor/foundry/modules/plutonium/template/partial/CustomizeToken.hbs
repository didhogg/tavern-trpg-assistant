<label class="ve-flex-v-center ve-mt-1">
	<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">{{name}}:</span>

	<select class="ve-w-100 ve-mx-1 ve-input-xs veapp__sel-row-inline ve-form-control ve-mr-1" name="{{formNameSelToken}}">
		<option value="-1" {{#unless url}}selected{{/unless}}>Default</option>
		{{#each availableTokens}}
			<option value="{{ix}}">{{name}}</option>
		{{/each}}
		<option value="-2" {{#if url}}selected{{/if}}>Custom</option>
	</select>
</label>

<div class="ve-flex-v-center ve-mt-1 {{#unless url}}ve-hidden{{/unless}}" data-name="{{formNameStgTokenCustom}}">
	<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Custom {{name}}:</span>

	<input class="ve-w-100 ve-mx-1 ve-input-xs ve-form-control veapp__ipt-row-inline ve-mr-2" name="{{formNameIptTokenCustom}}" type="text" value="{{url}}">

	<button class="ve-btn ve-btn-5et ve-btn-xxs ve-btn-default ve-w-initial" name="{{formNameBtnTokenCustom}}" title="Set Custom Token"><i class="fas fa-image ve-mr-0"></i></button>
</div>
