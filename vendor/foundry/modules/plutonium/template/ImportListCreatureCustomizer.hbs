<div class="ve-flex-col ve-window ve-min-h-0 ve-h-100">
	<div class="ve-flex-v-stretch ve-input-group ve-input-group--top ve-no-shrink">
		<input type="search" class="search ve-w-100 ve-form-control ve-h-initial" placeholder="Find {{titleSearch}}...">
		<button class="ve-btn ve-btn-5et veapp__btn-list-reset" name="btn-reset">Reset</button>
	</div>
	<div class="ve-flex-v-stretch ve-input-group ve-input-group--bottom ve-mb-1 ve-no-shrink" data-name="wrp-btns-sort">
		<button class="ve-btn ve-btn-5et ve-col-3 sort name" data-sort="name">Name</button>
		<button class="ve-btn ve-btn-5et ve-col-1 sort source" data-sort="source">Source</button>
		<button class="ve-btn ve-btn-5et ve-col-1 sort cr" data-sort="cr">CR</button>

		<button class="ve-btn ve-btn-5et ve-col-7" disabled></button>
	</div>

	<div class="veapp__list ve-mb-1 ve-h-100">
		{{#each rows}}
			<div class="ve-w-100 ve-flex-v-center ve-py-1 veapp__list-row ve-my-1">
				<span class="ve-col-3 ve-pl-1">{{name}}</span>
				<span class="ve-col-1 ve-text-center {{sourceClassName}}" title="{{sourceLong}}">{{sourceShort}}</span>
				<span class="ve-col-1 ve-text-center">{{cr}}</span>

				<div class="ve-col-7 ve-flex-col ve-pr-1 ve-pl-2 ve-bl-1p">
					<div class="ve-split-v-center">
						<label class="ve-flex-v-center ve-mr-2 ve-w-100 ve-min-w-0">
							<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Rename To:</span>
							<input class="ve-w-100 ve-mx-1 ve-input-xs ve-form-control veapp__ipt-row-inline" name="ipt-rename" type="text" value="{{customizerState.rename.rename}}">
						</label>

						<label class="ve-flex-v-center ve-mr-1" title="If this creature's name should be treated as a proper noun.">
							<span class="ve-no-wrap ve-mr-1 ve-w-100p ve-no-shrink ve-text-right">Named Creature:</span>
							<input name="cb-is-named" type="checkbox" {{checked customizerState.rename.isNamedCreature}}>
						</label>
					</div>

					<label class="ve-flex-v-center ve-mt-1" title="Only used if a &quot;Rename To&quot; value is provided. A shortened form of the creature's name, used in some auto-generated text.">
						<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right ve-muted">Rename To (Short):</span>
						<input class="ve-w-100 ve-mx-1 ve-input-xs ve-form-control veapp__ipt-row-inline" name="ipt-rename-short" type="text" placeholder="(Use full name)">
					</label>

					{{#if isAdjustableCr}}
						<label class="ve-flex-v-center ve-mt-1">
							<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Scale CR To:</span>

							<select class="ve-w-100 ve-mx-1 ve-input-xs veapp__sel-row-inline ve-form-control" name="sel-cr">
								<option value="-1" title="Use Existing CR">&mdash;</option>
								<option value="0">0</option>
								<option value="0.125">1/8</option>
								<option value="0.25">1/4</option>
								<option value="0.5">1/2</option>
								<option value="1">1</option>
								<option value="2">2</option>
								<option value="3">3</option>
								<option value="4">4</option>
								<option value="5">5</option>
								<option value="6">6</option>
								<option value="7">7</option>
								<option value="8">8</option>
								<option value="9">9</option>
								<option value="10">10</option>
								<option value="11">11</option>
								<option value="12">12</option>
								<option value="13">13</option>
								<option value="14">14</option>
								<option value="15">15</option>
								<option value="16">16</option>
								<option value="17">17</option>
								<option value="18">18</option>
								<option value="19">19</option>
								<option value="20">20</option>
								<option value="21">21</option>
								<option value="22">22</option>
								<option value="23">23</option>
								<option value="24">24</option>
								<option value="25">25</option>
								<option value="26">26</option>
								<option value="27">27</option>
								<option value="28">28</option>
								<option value="29">29</option>
								<option value="30">30</option>
							</select>
						</label>
					{{else if isAdjustableSummonSpellLevel}}
						<label class="ve-flex-v-center ve-mt-1">
							<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Summon Spell Level:</span>

							<select class="ve-w-100 ve-mx-1 ve-input-xs veapp__sel-row-inline ve-form-control" name="sel-summon-spell-level">
								<option value="-1">&mdash;</option>
								{{#each availableSummonSpellLevels}}
									<option value="{{this}}">{{Parser_getOrdinalForm this}}-level Spell</option>
								{{/each}}
							</select>
						</label>
					{{else if isAdjustableSummonClassLevel}}
						<label class="ve-flex-v-center ve-mt-1">
							<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">{{adjustableSummonClassLevelLabel}}:</span>

							<select class="ve-w-100 ve-mx-1 ve-input-xs veapp__sel-row-inline ve-form-control" name="sel-summon-class-level">
								<option value="-1">&mdash;</option>
								{{#each availableSummonClassLevels}}
									<option value="{{level}}">Level {{level}}{{#if className}} {{className}}{{/if}}</option>
								{{/each}}
							</select>
						</label>
					{{/if}}

					{{#if hasVariants}}
						<label class="ve-flex-v-center ve-mt-1">
							<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Variant:</span>

							<select class="ve-w-100 ve-mx-1 ve-input-xs veapp__sel-row-inline ve-form-control" name="sel-variant">
								<option value="-1">&mdash;</option>
								{{#each availableVariants}}
									<option value="{{ix}}">{{name}}</option>
								{{/each}}
							</select>
						</label>
					{{/if}}

					{{> plutonium.CustomizeToken contextCustomizeToken}}
					{{#if isTokensThreeDi}}
						{{> plutonium.CustomizeToken contextCustomizeTokenThreeDi}}
					{{/if}}

					<label class="ve-flex-v-center ve-mt-1" title="If the actor should be created as a &quot;character&quot; instead of an &quot;npc&quot;. Note that some features may not function as expected.">
						<span class="ve-no-wrap ve-mr-2 ve-w-140p ve-no-shrink ve-text-right">Player Character:</span>

						<input name="cb-is-character" type="checkbox" {{checked (eq customizerState.fvttType.foundryType "character")}} {{disabled (eq customizerState.fvttType.foundryType "character")}}>
					</label>
				</div>
			</div>
		{{/each}}
	</div>

	<div class="ve-no-shrink">
		<button class="ve-btn ve-btn-5et ve-btn-primary ve-w-100" name="btn-run">Import</button>
	</div>
</div>
