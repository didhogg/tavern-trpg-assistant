<div class="ve-flex-col ve-h-100 ve-window ve-min-h-0">
	<div class="ve-flex-v-stretch ve-input-group ve-input-group--top ve-no-shrink">
		<button class="ve-btn ve-btn-5et veapp__btn-filter" name="btn-filter">Filter</button>
		<button class="ve-btn ve-btn-5et" title="Toggle Filter Summary Display" name="btn-toggle-summary"><span class="glyphicon glyphicon-resize-small"></span></button>
		<div class="ve-w-100 ve-relative">
			<input type="search" autocomplete="off" autocapitalize="off" spellcheck="false" class="ve-h-100 search ve-form-control ve-lst__search ve-lst__search--no-border-h" placeholder="Find {{titleSearch}}...">
			<div class="ve-lst__wrp-search-glass ve-no-events ve-flex-vh-center"><span class="glyphicon glyphicon-search"></span></div>
			<div class="ve-lst__wrp-search-visible ve-no-events ve-flex-vh-center"></div>
		</div>
		<button class="ve-btn ve-btn-5et veapp__btn-list-feeling-lucky ve-flex-vh-center" name="btn-feeling-lucky" title="Feeling Lucky?"><span class="glyphicon glyphicon-random"></span></button>
		<button class="ve-btn ve-btn-5et veapp__btn-list-reset" name="btn-reset">Reset</button>
	</div>

	<div class="ve-fltr__mini-view ve-btn-group"></div>

	<div class="ve-flex-v-stretch ve-input-group ve-input-group--bottom ve-mb-1 ve-no-shrink" data-name="wrp-btns-sort">
		{{#if isRadio}}
			<button class="ve-btn ve-btn-5et {{#if isPreviewable}}ve-col-0-4{{else}}ve-col-1{{/if}} ve-px-1" disabled></button>
		{{else}}
			<label class="ve-btn ve-btn-5et {{#if isPreviewable}}ve-col-0-4{{else}}ve-col-1{{/if}} ve-px-1 ve-flex-vh-center"><input type="checkbox" name="cb-select-all"></label>
		{{/if}}

		{{#if isPreviewable}}
			<button class="ve-btn ve-btn-5et ve-col-0-6 ve-px-1" name="btn-toggle-all-previews">[+]</button>
		{{/if}}

		{{#each cols}}
			<button class="ve-btn ve-btn-5et ve-col-{{width}} ve-px-1 sort" data-sort="{{field}}" {{#if title}}title="{{title}}"{{/if}}>{{name}}</button>
		{{/each}}
	</div>

	<div class="veapp__list ve-mb-1 ve-h-100"></div>

	<div class="ve-no-shrink ve-flex-v-center">
		<button class="ve-btn ve-btn-5et ve-btn-primary ve-w-100" name="btn-run">{{titleButtonRun}}</button>
		{{#each buttonsAdditional}}
			<button class="ve-ml-2 ve-btn ve-btn-5et ve-btn-default ve-w-100" name="{{name}}">{{text}}</button>
		{{/each}}
	</div>
</div>
